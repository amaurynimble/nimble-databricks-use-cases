  {
   "name": "latest",
   "displayName": "latest",
   "queryLines": [
    "SELECT * FROM __CATALOG__.__SCHEMA__.shelf_products WHERE brand IS NOT NULL AND captured_at = (SELECT max(captured_at) FROM __CATALOG__.__SCHEMA__.shelf_products)"
   ]
  },
  {
   "name": "history",
   "displayName": "history",
   "queryLines": [
    "SELECT date(captured_at) AS day, brand, retailer, price FROM __CATALOG__.__SCHEMA__.shelf_products WHERE brand IN ('Nike','adidas','HOKA','On','New Balance','Asics','Brooks')"
   ]
  }
